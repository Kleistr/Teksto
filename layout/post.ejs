<article class="post">
    <div class="post-title">
        <h1 class="title"><%= page.title %></h2>
    </div>
    <% if (page.title !== "About") { %>
    <div class="post-meta">
        <span class="post-time"><%- date(page.date, "YYYY-MM-DD") %>　<span id = 'weekday'><%- date(page.date, "dddd") %></span></span>
        <% if (theme.update){ %>
            <span class="post-time hidden" id = 'expire-alert'><%- __('Updated', '<time datetime="' + page.updated + '"></time>') %></span>
            <%- js('js/updateTimeAlert.js') %>
        <% } %>
        <% if (page.author) { %>
        <span class="post-author"><%= page.author %></span>
        <% } else { %>
        <span class="post-author"><%= config.author %></span>
        <% } %>
        <%- partial('_partial/tags') %>
    </div>
    <% }%>
    <% if (page.image) { %>
    <div class="post-image">
        <img src="<%= page.image %>" alt="">
    </div>
    <% }%>
    <div class="post-content">
        <!-- addTocToArticle -->
        <%- partial('_partial/toc') %>
        <%- page.content %>
    </div>

</article>
<div class="prev_next">
    <%- partial('_partial/prev_next') %>
</div>

<div class="post-comment">
    <%- partial('_partial/disqus') %>
</div>
<div id="top">
    <a href="javascript:backToTop();">▲</a>
    <a href="javascript:downToBottom();">▼</a>
</div>
<!-- addTocToggle-->
<script>
    function backToTop() {
        $('html, body').animate({ scrollTop: 0 });
    }
    function downToBottom(){
        var docHeight = $('body').height();
        $('html, body').animate({ scrollTop: docHeight });
    }
    (function() {
        var tocLinks = document.querySelectorAll('.toc-dock .toc-link');
        if (!tocLinks.length) return;
        var headingMap = {};
        tocLinks.forEach(function(link) {
            var id = decodeURIComponent(link.getAttribute('href')).slice(1);
            var heading = document.getElementById(id);
            if (heading) headingMap[id] = link;
        });
        var headings = Object.keys(headingMap).map(function(id) {
            return document.getElementById(id);
        }).filter(Boolean);
        if (!headings.length) return;
        var currentActive = null;
        function clearActive() {
            if (currentActive) {
                currentActive.classList.remove('active');
                currentActive = null;
            }
        }
        function onScroll() {
            var scrollY = window.scrollY;
            var offset = window.innerHeight * 0.3;
            var target = null;
            for (var i = headings.length - 1; i >= 0; i--) {
                if (headings[i].getBoundingClientRect().top <= offset) {
                    target = headings[i];
                    break;
                }
            }
            clearActive();
            if (target && headingMap[target.id]) {
                currentActive = headingMap[target.id];
                currentActive.classList.add('active');
            }
        }
        var ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    onScroll();
                    ticking = false;
                });
                ticking = true;
            }
        });
        onScroll();
    })();
</script>