<section class="archive">
    <ul class="post-archive">
        <% site.tags.forEach(function(tag) { %>
        <div class="years">
            <div class="year"><%= tag.name %><span class="tag-count">（<%= tag.length %>）</span></div>
            <% tag.posts.forEach(function(post) { %>
            <li class="post-item">
                <a class="post-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
                <span class="post-date"><%= date(post.date, "MM月DD日") %></span>
            </li>
            <% }) %>
        </div>
        <% }) %>
    </ul>
</section>