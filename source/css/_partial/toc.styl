/*toc begin*/
.toc-dock
    position fixed
    left 80%
    top 50%
    transform translateY(-50%)
    z-index 999
    max-height 80vh
    width 18px
    overflow hidden
    transition width 0.35s cubic-bezier(0.4, 0, 0.2, 1)
    &:hover
        width 240px
        overflow-y auto
        overflow-x hidden
        &::-webkit-scrollbar
            width 3px
        &::-webkit-scrollbar-thumb
            background rgba(0, 0, 0, 0.12)
            border-radius 3px
    .toc-dock-header
        display none
        font-weight 700
        font-size 13px
        color rgba(0, 0, 0, 0.85)
        white-space nowrap
        border-bottom 1px solid rgba(0, 0, 0, 0.06)
    .toc-dock-body
        ol
            list-style none
            margin 0
            padding 0
        li
            list-style none
            margin 0
        ol li:before
            display none
        .toc-child
            margin-left 0
            padding-left 0
        .toc-link
            display flex
            align-items center
            padding 0.2em 0.6em 0.2em 0
            white-space nowrap
            text-decoration none
            color rgba(0, 0, 0, 0.35)
            font-size 13px
            line-height 1.5
            border-bottom none !important
            border-left 2px solid transparent
            transition color 0.2s ease, border-color 0.2s ease
            &:before
                content ""
                display inline-block
                flex-shrink 0
                margin 0 6px 0 0
                border-radius 2px
                background rgba(0, 0, 0, 0.12)
                transition background 0.2s ease, width 0.2s ease, transform 0.2s ease
            &:hover
                color var(--theme-color)
                font-size: 0.8em;
                transition: font-size 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                &:before
                    background var(--theme-color)
                    transform scaleX(1.2)
            &.active
                color var(--theme-color)
                font-size: 0.8em;
                transition: font-size 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                font-weight 600
                &:before
                    background var(--theme-color)
        .toc-level-2 > .toc-link
            padding-left 0
            &:before
                width 16px
                height 4px
        .toc-level-3 > .toc-link
            padding-left 0.4em
            font-size 12px
            &:before
                width 10px
                height 3px
        .toc-level-4 > .toc-link,
        .toc-level-5 > .toc-link,
        .toc-level-6 > .toc-link
            padding-left 0.8em
            font-size 11px
            color rgba(0, 0, 0, 0.25)
            &:before
                width 6px
                height 3px
        .toc-text
            opacity 0
            transition opacity 0.3s ease 0.08s
            overflow hidden
            text-overflow ellipsis
    &:hover .toc-dock-body .toc-text
        opacity 1
    &:hover .toc-dock-body .toc-level-3 > .toc-link .toc-text
        transition-delay 0.12s
    &:hover .toc-dock-body .toc-level-4 > .toc-link .toc-text,
    &:hover .toc-dock-body .toc-level-5 > .toc-link .toc-text,
    &:hover .toc-dock-body .toc-level-6 > .toc-link .toc-text
        transition-delay 0.15s

@media screen and (max-width: 1100px)
    .toc-dock
        display none

/* toc end*/
